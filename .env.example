# Bot token from https://discord.com/developers/applications > your app > Bot
DISCORD_TOKEN=

# Optional. Limit slash commands to this one server ID.
# Leave empty to register them in every server the bot is in.
GUILD_ID=

# Optional. Folder on the host that holds your audiobooks (default ./books).
BOOKS_PATH=./books

# Optional. Minutes to wait in an empty voice channel before leaving (default 5).
EMPTY_LEAVE_MINUTES=5

# Optional. Public address of the web player (Audiobookshelf), shown as a link
# on the friends homepage. Example: https://listen.example.com
LISTEN_URL=

# Optional. Public address of the friends homepage. /help links to it as the
# place to add books. Example: https://shelf.example.com
SHELF_URL=

# Optional. Read-only Prowlarr search on the friends homepage. Leave
# PROWLARR_URL empty to keep it off. Results are shown as text only: nothing
# can be downloaded or added to the shelf from them.
PROWLARR_URL=
# Prowlarr > Settings > General > API Key
PROWLARR_API_KEY=
# Optional. Only search these indexers (numbers, comma separated). Empty means
# every indexer Prowlarr has. List them with:
#   curl -H "X-Api-Key: <key>" <PROWLARR_URL>/api/v1/indexer
PROWLARR_INDEXER_IDS=
# Optional. If Prowlarr sits behind Cloudflare Access, a service token lets the
# bot through (Zero Trust > Access > Service Auth). Set both or neither.
PROWLARR_CF_ACCESS_CLIENT_ID=
PROWLARR_CF_ACCESS_CLIENT_SECRET=

# Optional. Movies and TV on the friends homepage, through Jellyseerr / Seerr.
# Leave JELLYSEERR_URL empty to keep them off. Friends search and press
# "Request"; Jellyseerr does the rest.
JELLYSEERR_URL=
# Jellyseerr > Settings > General > API Key
JELLYSEERR_API_KEY=
# Optional. File requests under this Jellyseerr user (its number is in the URL
# of its page under Users). That user's permissions and quotas then apply, so
# a user without auto-approve makes every request wait for your approval.
# Empty means requests are filed as the key's admin and approved at once.
JELLYSEERR_USER_ID=
# Optional. Service token if Jellyseerr sits behind Cloudflare Access.
JELLYSEERR_CF_ACCESS_CLIENT_ID=
JELLYSEERR_CF_ACCESS_CLIENT_SECRET=

# Optional. An "Upload a book" form on the friends homepage, for your own
# audio files. Leave UPLOAD_EMAILS empty to keep it off. List the people who
# may upload by the email they log in with (comma separated), or * for
# everybody who can open the page. Needs Cloudflare Access in front, which is
# what tells the page who is asking.
UPLOAD_EMAILS=
# Optional. Largest book that can be uploaded, in gigabytes (default 2).
UPLOAD_MAX_GB=
