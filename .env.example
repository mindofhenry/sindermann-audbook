# Bot token from https://discord.com/developers/applications > your app > Bot
DISCORD_TOKEN=

# Optional. Limit slash commands to this one server ID.
# Leave empty to register them in every server the bot is in.
GUILD_ID=

# Optional. Folder on the host that holds your audiobooks (default ./books).
BOOKS_PATH=./books

# Optional. Minutes to wait in an empty voice channel before leaving (default 5).
EMPTY_LEAVE_MINUTES=5

# Optional. Public address of the web player (Audiobookshelf), shown as a link
# on the friends homepage. Example: https://listen.example.com
LISTEN_URL=

# Optional. Read-only Prowlarr search on the friends homepage. Leave
# PROWLARR_URL empty to keep it off. Results are shown as text only: nothing
# can be downloaded or added to the shelf from them.
PROWLARR_URL=
# Prowlarr > Settings > General > API Key
PROWLARR_API_KEY=
# Optional. Only search these indexers (numbers, comma separated). Empty means
# every indexer Prowlarr has. List them with:
#   curl -H "X-Api-Key: <key>" <PROWLARR_URL>/api/v1/indexer
PROWLARR_INDEXER_IDS=
# Optional. If Prowlarr sits behind Cloudflare Access, a service token lets the
# bot through (Zero Trust > Access > Service Auth). Set both or neither.
PROWLARR_CF_ACCESS_CLIENT_ID=
PROWLARR_CF_ACCESS_CLIENT_SECRET=
